{
  "enabledPlugins": {
    "dimi@dimi-skills": true
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list)",
      "Bash(git branch -a)",
      "Bash(git branch -vv)",
      "Bash(git fetch)",
      "Bash(git fetch origin)",
      "Bash(git fetch origin *)",
      "Bash(git merge-base*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git check-ignore*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh run view*)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm exec tsc*)",
      "Bash(pnpm exec eslint*)",
      "Bash(pnpm exec prettier --check*)",
      "Bash(pnpm exec playwright test*)",
      "Bash(ruff check)",
      "Bash(ruff check *)",
      "Bash(ruff format --check*)",
      "Bash(mypy *)",
      "Bash(pytest *)",
      "Bash(python -m pytest*)",
      "Read(**)",
      "Edit(apps/**)",
      "Edit(services/**)",
      "Edit(packages/**)"
    ],
    "deny": [
      "Agent(fork)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(git diff*--output*)",
      "Bash(git log*--output*)",
      "Bash(git show*--output*)",
      "Bash(git diff*--ext-diff*)",
      "Bash(git log*--ext-diff*)",
      "Bash(git show*--ext-diff*)",
      "Bash(git diff*--no-index*)",
      "Bash(git diff*.env*)",
      "Bash(git log*.env*)",
      "Bash(git show*.env*)",
      "Bash(git fetch*--upload-pack*)",
      "Bash(git pull*--upload-pack*)",
      "Bash(git clone*--upload-pack*)",
      "Bash(git ls-remote*--upload-pack*)",
      "Bash(git fetch*--exec*)",
      "Bash(git pull*--exec*)",
      "Bash(git clone*--exec*)",
      "Bash(git ls-remote*--exec*)",
      "Bash(git fetch * +*)",
      "Bash(git fetch*--force*)",
      "Bash(git fetch * -f)",
      "Bash(git fetch * -f *)"
    ]
  }
}
